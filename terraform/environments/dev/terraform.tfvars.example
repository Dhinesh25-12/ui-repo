# Example variable values for the dev environment.
# Copy to terraform.tfvars and adjust as needed:
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "us-east-1"
project_name = "insurance-portal"
environment  = "dev"

vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

instance_count = 1
instance_type  = "t3.micro"
key_name       = null

db_engine         = "postgres"
db_engine_version = "16.4"
db_instance_class = "db.t3.micro"
db_name           = "insuranceportal"
db_username       = "dbadmin"
# db_password should NOT be committed. Set it via TF_VAR_db_password
# or an environment-specific secrets manager instead.

alert_email = "devops@example.com"

tags = {
  Owner = "platform-team"
}
